{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "foreground": "#FFFFFF",
    "prompt": "#FFFFFF",
    "dark": "#111111",
    "os": "#00897B",
    "session": "#C386F1",
    "path": "#FF479C",
    "git": "#FFFB38",
    "git-modified": "#FF9248",
    "git-diverged": "#FF4500",
    "git-ahead": "#B388FF",
    "git-behind": "#B388FF",
    "node": "#6CA35E",
    "go": "#8ED1F7",
    "python": "#FFDE57",
    "ruby": "#AE1401",
    "rust": "#DEA584",
    "aws": "#FFA400",
    "kubernetes": "#326CE5",
    "argocd": "#EF7B4D",
    "helm": "#0F1689",
    "docker": "#2496ED",
    "terraform": "#7B42BC",
    "execution": "#83769C",
    "time": "#2E9599",
    "error": "#E91E63",
    "root": "#FFFF66"
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:prompt",
    "template": "{{ if .Interrupted }}<red>^C </>{{ end }}❯ "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "cache": {
            "duration": "24h",
            "strategy": "session"
          },
          "foreground": "p:foreground",
          "background": "p:os"
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "p:foreground",
          "background": "p:session",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:foreground",
          "background": "p:path",
          "template": " \uea83  {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_separator_icon": "/",
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "p:dark",
          "background": "p:git",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-modified{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-diverged{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git-behind{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "foreground": "p:foreground",
          "background": "p:node",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "go",
          "style": "powerline",
          "foreground": "p:dark",
          "background": "p:go",
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "python",
          "style": "powerline",
          "foreground": "p:dark",
          "background": "p:python",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "ruby",
          "style": "powerline",
          "foreground": "p:foreground",
          "background": "p:ruby",
          "template": " \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_mode": "files"
          }
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "cache": {
            "duration": "24h",
            "strategy": "folder"
          },
          "foreground": "p:dark",
          "background": "p:rust"
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "break",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:foreground",
          "background": "p:os",
          "background_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "template": " \ue23a ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:foreground",
          "background": "p:execution",
          "template": " \ueba2 {{ .FormattedMs }} ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:dark",
          "background": "p:time",
          "template": " {{ .CurrentDate | date .Format }} ",
          "invert_powerline": true
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "root",
          "style": "powerline",
          "foreground": "p:dark",
          "background": "p:root",
          "template": " \uf0ad ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:prompt",
          "template": "❯"
        }
      ]
    }
  ],
  "tooltips_action": "replace",
  "tooltips": [
    {
      "type": "aws",
      "tips": [
        "aws"
      ],
      "style": "powerline",
      "foreground": "p:dark",
      "background": "p:aws",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "cache": {
        "duration": "10s",
        "strategy": "session"
      }
    },
    {
      "type": "kubectl",
      "tips": [
        "kubectl",
        "k"
      ],
      "style": "powerline",
      "foreground": "p:foreground",
      "background": "p:kubernetes",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "template": " \u2388 {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }} ",
      "cache": {
        "duration": "5s",
        "strategy": "session"
      }
    },
    {
      "type": "argocd",
      "tips": [
        "argocd"
      ],
      "style": "powerline",
      "foreground": "p:dark",
      "background": "p:argocd",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "template": " \ue734 {{ .Name }}{{ if .User }}:{{ .User }}{{ end }}{{ if .Server }}@{{ .Server }}{{ end }} "
    },
    {
      "type": "helm",
      "tips": [
        "helm"
      ],
      "style": "powerline",
      "foreground": "p:foreground",
      "background": "p:helm",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "template": " \ue7fb {{ .Version }} ",
      "cache": {
        "duration": "24h",
        "strategy": "device"
      }
    },
    {
      "type": "docker",
      "tips": [
        "docker",
        "docker-compose"
      ],
      "style": "powerline",
      "foreground": "p:dark",
      "background": "p:docker",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "template": " \uf308 {{ .Context }} ",
      "cache": {
        "duration": "5s",
        "strategy": "session"
      }
    },
    {
      "type": "terraform",
      "tips": [
        "terraform",
        "tf"
      ],
      "style": "powerline",
      "foreground": "p:foreground",
      "background": "p:terraform",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "template": " \ue8bd {{ .WorkspaceName }} ",
      "cache": {
        "duration": "5s",
        "strategy": "folder"
      }
    },
    {
      "type": "status",
      "tips": [
        "aws",
        "kubectl",
        "k",
        "argocd",
        "helm",
        "docker",
        "docker-compose",
        "terraform",
        "tf"
      ],
      "style": "powerline",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "foreground": "p:foreground",
      "background": "p:os",
      "background_templates": [
        "{{ if gt .Code 0 }}p:error{{ end }}"
      ],
      "template": " \ue23a ",
      "options": {
        "always_enabled": true
      }
    },
    {
      "type": "executiontime",
      "tips": [
        "aws",
        "kubectl",
        "k",
        "argocd",
        "helm",
        "docker",
        "docker-compose",
        "terraform",
        "tf"
      ],
      "style": "powerline",
      "powerline_symbol": "\ue0b2",
      "invert_powerline": true,
      "foreground": "p:foreground",
      "background": "p:execution",
      "template": " \ueba2 {{ .FormattedMs }} ",
      "options": {
        "always_enabled": true
      }
    },
    {
      "type": "time",
      "tips": [
        "aws",
        "kubectl",
        "k",
        "argocd",
        "helm",
        "docker",
        "docker-compose",
        "terraform",
        "tf"
      ],
      "style": "diamond",
      "foreground": "p:dark",
      "background": "p:time",
      "template": " {{ .CurrentDate | date .Format }} ",
      "invert_powerline": true
    }
  ]
}
