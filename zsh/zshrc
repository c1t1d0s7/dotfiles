# ~/.zshrc — 대화형 셸 전용
# 환경변수(PATH 등)는 ~/.zshenv 참조.
# alias 등 주제별 설정은 ~/.config/zsh/*.zsh — OMZ가 자동으로 소싱한다.

# Powerlevel10k instant prompt. 반드시 파일 최상단에 유지할 것.
# 콘솔 입력이 필요한 코드(비밀번호, y/n 확인)는 이 블록 위에 둬야 한다.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
# 커스텀 플러그인/테마/설정 위치. OMZ 기본값($ZSH/custom) 대신 dotfiles가 관리하는 곳으로.
export ZSH_CUSTOM="$HOME/.config/zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

# compaudit(fpath 권한 검사) 생략 — 단독 사용 머신이라 불필요. 시작 시간 ~16ms 절약.
ZSH_DISABLE_COMPFIX="true"

# zsh-syntax-highlighting은 다른 플러그인이 정의한 위젯을 감싸야 하므로 반드시 마지막.
plugins=(
  git
  sudo
  fzf
  kubectl
  kubectx
  aws
  terraform
  helm
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# brew가 설치한 도구들의 공식 completion은 $HOMEBREW_PREFIX/share/zsh/site-functions에
# 들어간다. 이 경로를 기본 fpath에 넣어주는 건 homebrew가 설치한 zsh인데,
# 로그인 셸은 /bin/zsh(애플 시스템 zsh)라서 직접 추가해야 한다.
# 없으면 _gh, _argocd, _eksctl, _istioctl, _k9s, _bat 등이 조용히 로드되지 않는다.
# compinit은 아래 oh-my-zsh.sh가 실행하므로 반드시 그 전에 넣을 것.
# (중복은 .zshenv의 typeset -U fpath가 막아준다)
fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)

source $ZSH/oh-my-zsh.sh

# 프롬프트 커스터마이즈: `p10k configure` 또는 ~/.p10k.zsh 직접 편집
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
