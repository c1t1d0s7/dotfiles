# Interactive zsh configuration.

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/zsh"

# oh-my-posh owns the prompt.
ZSH_THEME=""

# Keep compaudit enabled on multi-user Linux systems.
[[ "$OSTYPE" != darwin* ]] || ZSH_DISABLE_COMPFIX="true"

# Must remain last.
plugins=(
  git
  sudo
  fzf
  kubectl
  kubectx
  aws
  terraform
  helm
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Add Homebrew completions when available.
if [[ -n ${HOMEBREW_PREFIX:-} ]]; then
  fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)
fi

# VS Code may inject PATH entries after user startup files.
_dotfiles_prioritize_path() {
  path=(
    $HOME/go/bin
    $HOME/.local/bin
    ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin}
    ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/sbin}
    $path
  )
  typeset -gU path
}
_dotfiles_prioritize_path

# Keep the shell usable if a clone failed during installation.
[[ ! -r "$ZSH/oh-my-zsh.sh" ]] || source "$ZSH/oh-my-zsh.sh"

# Keep the shell usable if oh-my-posh is not installed yet.
if (( $+commands[oh-my-posh] )); then
  eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/config.omp.json")"
fi

# Reapply once after VS Code finishes its environment injection.
if [[ -n ${VSCODE_INJECTION:-} ]]; then
  autoload -Uz add-zsh-hook
  _dotfiles_prioritize_path_once() {
    _dotfiles_prioritize_path
    add-zsh-hook -d precmd _dotfiles_prioritize_path_once
    unfunction _dotfiles_prioritize_path_once _dotfiles_prioritize_path
  }
  add-zsh-hook precmd _dotfiles_prioritize_path_once
else
  unfunction _dotfiles_prioritize_path
fi
