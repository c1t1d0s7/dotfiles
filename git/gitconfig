[init]
	defaultBranch = main

[user]
	# 이름·이메일은 아래 include가 주입한다. 공개 리포이므로 리포에 두지 않는다.
	# 기본 신원은 일부러 없다 — ~/git/<계정>/ 밖에서는 커밋이 거부된다.
	useConfigOnly = true       # 이메일을 못 찾으면 사용자@호스트명 으로 추측하지 말고 커밋을 거부

[core]
	pager = less -FRX          # 한 화면에 들어오면 그냥 출력, 넘치면 페이징
	# editor는 적지 않는다. git이 $EDITOR(zshenv가 nvim 또는 vi로 정한다)를 쓰고,
	# 그마저 없는 GUI 환경에서는 git 자체 기본값인 vi로 떨어진다.
	autocrlf = input
	# excludesfile은 적지 않는다. ~/.config/git/ignore 가 git의 기본값이다.

[credential]
	helper = osxkeychain

# 신원 설정. 이름·이메일·조직명은 사람마다 다르고 공개 리포에 둘 것도 아니므로
# 리포에 두지 않는다. install.sh가 물어봐서 아래 파일들을 만든다.
#
#   ~/.config/git/identity         개인 이름/이메일 + 조직별 includeIf
#   ~/.config/git/identity-<조직>  ~/git/<조직>/ 아래에서만 덮어쓸 이름/이메일
#
# includeIf는 include된 파일 안에서도 동작하므로, 조직 목록 전체가 저 한 파일에 들어간다.
[include]
	path = ~/.config/git/identity

[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true             # 충돌 해결을 기록해뒀다가 재사용. rebase 반복 시 효과 큼

[merge]
	conflictstyle = zdiff3     # 충돌 마커에 공통 조상까지 표시

[diff]
	algorithm = histogram
	colorMoved = default       # 이동한 코드와 실제 수정된 코드를 구분

[commit]
	template = ~/.config/git/message
	verbose = true             # 커밋 메시지 작성 시 diff를 함께 표시

[branch]
	sort = -committerdate      # 최근 커밋된 브랜치를 위로

[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true

[help]
	autocorrect = prompt       # 오타 교정을 자동 실행하지 않고 확인 후 실행

[color]
	ui = auto

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --
	last = log -1 HEAD
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
