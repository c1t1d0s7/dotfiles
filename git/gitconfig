[init]
	defaultBranch = main

[user]
	# Identities are injected per ~/git/<account>/ by the include below.
	useConfigOnly = true

[core]
	pager = less -FRX
	autocrlf = input

# Generated identity and includeIf rules.
[include]
	path = ~/.config/git/identity

[pull]
	rebase = true
[rebase]
	autoSquash = true
	autoStash = true
	missingCommitsCheck = warn
[rerere]
	enabled = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[commit]
	template = ~/.config/git/message
	verbose = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[help]
	autocorrect = prompt

[color]
	ui = auto

[column]
	ui = auto

# hash | relative date | subject | author | refs
[log]
	date = relative
	decorate = auto

[format]
	pretty = tformat:%C(auto,yellow)%h%C(reset) %C(auto,cyan)%<(12,trunc)%ad%C(reset) %C(auto,bold)%s%C(reset) %C(auto,green)· %an%C(reset)%C(auto)%d%C(reset)

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --
	last = log -1
	lg = log --graph --all --date-order
	ll = log --stat
