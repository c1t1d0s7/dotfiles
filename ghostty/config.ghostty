# Theme.
theme = dracula
# Background.
background-opacity = 0.8
background-blur = 50

# Window size.
window-width = 75
window-height = 25

# Window padding.
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# Fonts.
font-size = 22
font-family = "JetBrainsMono Nerd Font"
# Korean fallback.
font-family = "Sarasa Mono K"

# Map Korean Unicode ranges to Sarasa Mono K.
font-codepoint-map = U+AC00-U+D7A3=Sarasa Mono K
font-codepoint-map = U+3130-U+318F=Sarasa Mono K
font-codepoint-map = U+1100-U+11FF=Sarasa Mono K
font-codepoint-map = U+A960-U+A97F=Sarasa Mono K
font-codepoint-map = U+D7B0-U+D7FF=Sarasa Mono K

# Shell integration.
shell-integration = zsh
shell-integration-features = ssh-env, ssh-terminfo

# Paste without confirmation.
clipboard-paste-protection = false
